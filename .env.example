# TrustCast Environment Configuration
# Copy this file to .env and fill in values as needed

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Frontend (Vite reads this from frontend/.env.local when needed)
# VITE_API_BASE_URL=http://localhost:8000

# Step 2 weather ingestion (public, no API key required)
OPEN_METEO_SINGLE_RUNS_URL=https://single-runs-api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=600

# Database (SQLite for now, PostgreSQL later)
# DATABASE_URL=sqlite:///./trustcast.db

# Future: API Keys (do NOT commit real keys)
# GFS_API_KEY=
# ECMWF_API_KEY=

# Step 3 historical verification (public, no API key required)
OPEN_METEO_PREVIOUS_RUNS_URL=https://previous-runs-api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
PERFORMANCE_CACHE_TTL_SECONDS=21600
